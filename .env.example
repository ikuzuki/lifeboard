# Sync and sign-in are entirely optional. With this file absent or blank the app runs
# fully signed out, stores everything in IndexedDB, and never touches the network.
#
# Copy to .env.local and fill in. Only VITE_-prefixed names reach the browser bundle,
# and everything here is public by design: none of it is a secret.

# Region every resource below lives in.
VITE_AWS_REGION=eu-west-2

# Cognito user pool, federated to Google as an identity provider.
VITE_COGNITO_USER_POOL_ID=eu-west-2_xxxxxxxxx
VITE_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Hosted UI origin, no trailing slash. Either the Cognito-issued domain or a custom one.
VITE_COGNITO_DOMAIN=https://lifeboard.auth.eu-west-2.amazoncognito.com

# Where the hosted UI returns to after Google. Must be listed as a callback URL on the
# app client. Defaults to the page origin when unset, which is right for most deployments.
VITE_COGNITO_REDIRECT_URI=http://localhost:5173

# Identity pool that exchanges the user pool token for temporary AWS credentials.
VITE_COGNITO_IDENTITY_POOL_ID=eu-west-2:00000000-0000-0000-0000-000000000000

# Bucket holding one document per user at users/{identityId}/state.json. The authenticated
# role needs s3:GetObject and s3:PutObject on that prefix only, and CORS must allow GET
# and PUT from the app origin with ETag exposed.
VITE_SYNC_BUCKET=lifeboard-state

# Brain dump parsing. Base URL of the capture API, no trailing slash; the client posts
# to {endpoint}/capture with the Cognito ID token as a bearer credential. Leave this
# unset and the brain dump surface is hidden entirely rather than offered and failing.
# The Anthropic API key is not here and never reaches the browser: it lives in SSM and
# is read by the Lambda. `terraform output capture_endpoint` prints this value.
VITE_CAPTURE_ENDPOINT=https://xxxxxxxxxx.execute-api.eu-west-2.amazonaws.com
