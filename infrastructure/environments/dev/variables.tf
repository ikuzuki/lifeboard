variable "environment" {
  description = "Deployment environment"
  type        = string
  default     = "dev"

  validation {
    condition     = contains(["dev", "prod"], var.environment)
    error_message = "Environment must be dev or prod."
  }
}

variable "bucket_suffix" {
  description = "Optional suffix for globally-unique S3 bucket names. Leave empty unless lifeboard-app-dev or lifeboard-user-data-dev is already taken by another account."
  type        = string
  default     = ""
}

variable "user_pool_domain_prefix" {
  description = "Prefix for the Cognito hosted UI domain. Globally unique across all AWS accounts."
  type        = string
  default     = "lifeboard-dev"
}

variable "secret_prefix" {
  description = "Parameter Store path prefix. Full names are {prefix}/{environment}/{name}."
  type        = string
  default     = "/lifeboard"
}

variable "capture_monthly_limit_usd" {
  description = "Anthropic spend ceiling across everyone, per calendar month. Binds before the per-user cap does once there is more than one user."
  type        = number
  default     = 5
}

variable "capture_user_monthly_limit_usd" {
  description = "Anthropic spend ceiling per person, per calendar month."
  type        = number
  default     = 2
}

variable "enable_auth" {
  description = <<-EOT
    Create the Cognito user pool, the identity pool and the per-user S3 bucket.

    Turn this off to deploy the app as a local-only build: it works entirely from
    IndexedDB, so the static site is fully usable without sign-in, and cross-device
    sync and brain dump parsing are the only things missing.

    When on, the Google client id and secret must already exist in Parameter Store
    under {secret_prefix}/{environment}. See auth.tf for the two commands.
  EOT
  type        = bool
  default     = true
}

variable "domain_name" {
  description = "Custom domain for the app, e.g. lifeboard.isseikuzuki.co.uk. Null keeps the app on its *.cloudfront.net address and skips ACM and Route 53 entirely, which is the supported state until a hosted zone exists."
  type        = string
  default     = null
}

variable "route53_zone_name" {
  description = "Name of the Route 53 hosted zone that owns domain_name, e.g. isseikuzuki.co.uk. Only read when domain_name is set. The zone must already exist in this account."
  type        = string
  default     = null

  validation {
    condition     = var.domain_name == null || var.route53_zone_name != null
    error_message = "route53_zone_name is required whenever domain_name is set."
  }
}

variable "dev_server_origin" {
  description = "Origin of the local Vite dev server. Added to the Cognito callback and logout URLs and to the user-data bucket CORS allowlist so development runs against real auth and real storage."
  type        = string
  default     = "http://localhost:5173"
}

variable "enable_push" {
  description = <<-EOT
    Create the web push dispatcher, its two schedules and its VAPID parameters.

    Off by default, and it needs three things before it does anything: the client
    subscribing and writing a digest, a VAPID pair generated by hand into the two
    SSM parameters push.tf outputs, and lambdas/push_dispatch/build.sh having run.
    Needs enable_auth as well, since the digests live in the per-user bucket.
  EOT
  type        = bool
  default     = false
}

variable "initial_allowlist" {
  description = "Addresses seeded into the sign-in allowlist on first apply. Change it afterwards with `aws ssm put-parameter --name /lifeboard/dev/signin-allowlist --value ... --overwrite`, which needs no deploy."
  type        = string
  default     = ""
}
